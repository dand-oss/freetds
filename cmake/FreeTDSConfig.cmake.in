@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@WITH_OPENSSL@)
    get_filename_component(_freetds_ports_root "${PACKAGE_PREFIX_DIR}/.." ABSOLUTE)
    find_dependency(OpenSSL 3 CONFIG
        PATHS "${_freetds_ports_root}/ssl-jp" NO_DEFAULT_PATH)
    unset(_freetds_ports_root)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FreeTDSTargets.cmake")
check_required_components(FreeTDS)
